{
    "name": "lukena-xxl/nameste",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/yaml": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/config": "^7.4",
        "symfony/flex": "^2.10",
        "intervention/image": "^3.11",
        "ramsey/uuid": "^4.9",
        "symfony/runtime": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/mime": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    }
}
